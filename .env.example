# Copie para .env e preencha localmente. Nunca faça commit do .env.

# Neon Postgres
PG_HOST=<seu-host-direto>.neon.tech
PG_PORT=5432
PG_DATABASE=neondb
PG_USER=cdc_user
PG_PASSWORD=<senha-do-cdc_user>

# Confluent Cloud
CONFLUENT_BOOTSTRAP=<bootstrap-server>:9092
CONFLUENT_API_KEY=<api-key-do-cluster>
CONFLUENT_API_SECRET=<api-secret-do-cluster>
SCHEMA_REGISTRY_URL=<url-do-schema-registry>
SR_API_KEY=<api-key-do-schema-registry>
SR_API_SECRET=<api-secret-do-schema-registry>
